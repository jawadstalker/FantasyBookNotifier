# Copy to .env for local development. Never commit real credentials.
PORT=5000
HOST=127.0.0.1
FLASK_DEBUG=0
LOG_LEVEL=INFO

# Email notifications (Gmail app password, not your account password)
SENDER_EMAIL=
APP_PASSWORD=
RECEIVER_EMAIL=

# Optional overrides
BOOKS_CSV_PATH=Books.csv
SUMMARIZER_MODEL=facebook/bart-large-cnn
MAX_REQUEST_BYTES=1048576
MAX_NLP_TEXT_CHARS=20000
MAX_RECOMMENDATION_KEYWORDS_CHARS=1000

# Background queue (Docker Compose overrides these hostnames automatically)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Persistent job and subscription database (SQLite by default)
DATABASE_URL=sqlite:///fantasybooknotifier.db
